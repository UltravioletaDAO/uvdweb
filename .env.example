GENERATE_SOURCEMAP=false
REACT_APP_API_URL=https://api.ultravioletadao.xyz
REACT_APP_SHOW_SIGNUP_BUTTONS=true
REACT_APP_TWITCH_CLIENT_ID=bk2tvufdg3nodg70rzyt7pxbfwuho8
# Flag de debug: el canonico es REACT_APP_DEBUG_ENABLED (lo usan el codigo,
# CLAUDE.md y frontend-ci.yml). REACT_APP_DEBUG queda solo como alias
# heredado que src/lib/config.js sigue aceptando; no lo setees en entornos nuevos.
REACT_APP_DEBUG_ENABLED=false
REACT_APP_TTS_ENABLED=true
REACT_APP_WHEEL_VERIFY_WALLET=true
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
REACT_APP_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here 
# Bounties UI (backend API Gateway offline; enable only when the bounties backend is live again)
REACT_APP_BOUNTIES_ENABLED=false

# Stream search API (Lambda uvd-stream-search behind API Gateway; see infra/stream-search/)
REACT_APP_STREAM_SEARCH_API=https://pbs5xr8wye.execute-api.us-east-1.amazonaws.com
